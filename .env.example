# ai-jinji-24h — 環境変数テンプレート（実 secret は入れない・commit してよいのはこのファイルのみ）
#
# 【local と Production を混同しない】
#   - Production 資格情報は Vercel のプロジェクト env にのみ置く（repo には置かない）。
#   - local 開発で Production Supabase に接続しないよう、dev(next dev) では env-guard が働き、
#     Supabase URL が localhost/127.0.0.1 以外なら起動を拒否する（lib/supabase/env-guard.ts）。
#   - local 開発の推奨手順:
#       1) `npx supabase start`（config.toml = ai-jinji-24h-local / port 544xx）
#       2) `npm run dev:local`（local Supabase の URL/anon/service key を自動注入して next dev。Production を使わない）
#     もしくは本ファイルを `.env.development.local` にコピーし、local 用の値で埋める（dev では .env.local より優先）。
#
# ── Supabase（local 既定値。Production 値をここに書かない）────────────────────────────────
# local Supabase API（`npx supabase start` の API URL）。dev では必ず localhost/127.0.0.1。
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54421
# local anon / service_role key は `npx supabase status -o env` で取得（local-only の demo key）。ここに実値を書かない。
NEXT_PUBLIC_SUPABASE_ANON_KEY=<run: npx supabase status -o env  (ANON_KEY)>
SUPABASE_SERVICE_ROLE_KEY=<run: npx supabase status -o env  (SERVICE_ROLE_KEY)>

# dev から remote(staging 等)の Supabase を意図的に使う稀なケースのみ true（既定は未設定＝local 強制）。
# ALLOW_REMOTE_SUPABASE_IN_DEV=true

# ── capability token（local は synthetic 値・Production 値を local smoke に使わない）─────────
INTERVIEW_TOKEN_SECRET=local-dev-token-secret-change-me-0123456789abcdef

# ── フィーチャーゲート（既定 OFF。Phase smoke 時のみ process-local で ON にする）────────────
TRANSCRIPT_INGEST_ENABLED=false
OPENAI_REALTIME_ENABLED=false
OPENAI_EVALUATION_ENABLED=false

# ── その他（必要に応じて。実 secret はここに書かない）───────────────────────────────────
# AUTH_LOGIN_THROTTLE_SECRET=
# TURNSTILE_SECRET_KEY=
# OPENAI_API_KEY=
# EVALUATION_MODEL=
