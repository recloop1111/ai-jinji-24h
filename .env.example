# AIMEN24 環境変数の例（実値はコミットしない）。値はプレースホルダ。
#
# v1 ではアプリからのメール送信機能を持たない（Resend/SMTP 不使用）。
# 応募者レポートはダウンロードのみ、メンバー招待は招待リンクの共有で成立する。
# メール送信が必要になった場合はここに送信設定を追加する。

# 内部バッチ（手動トリガ）認証用シークレット。
# POST /api/internal/batch/monthly-billing?dryRun=1 / suspension-execute 等で
# Authorization: Bearer ${INTERNAL_BATCH_SECRET} を検証する。未設定は fail-closed（401）。
INTERNAL_BATCH_SECRET=replace-with-strong-random-secret

# Vercel Cron 用シークレット。設定すると Vercel が cron 実行時に
# Authorization: Bearer ${CRON_SECRET} を自動付与する。
# 月次請求バッチ（GET /api/internal/batch/monthly-billing・毎月1日 UTC00:00=JST09:00）の
# 認証に使用。未設定は fail-closed（cron からの実行も 401）。第三者は叩けない。
CRON_SECRET=replace-with-strong-random-secret
